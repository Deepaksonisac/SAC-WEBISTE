        $('.c-accordion-box:first-child').addClass('c-active');
        $(function () {
            $('.c-accordion-box').click(function () {
                $(this).toggleClass(' c-active ');
                $(this).siblings().removeClass(' c-active ');
                $('.c-accordion-content-text').stop().slideUp();
