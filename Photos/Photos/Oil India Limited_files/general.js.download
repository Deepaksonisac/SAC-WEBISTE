        if (
            event.type === "click" ||
            (event.type === "keydown" && (event.key === "Enter" || event.key === " "))
        ) {
            event.preventDefault();
            event.stopPropagation();
            $(".search-box").slideToggle();
            $(".srch-icon").toggleClass("active");
        }
    });
}
        $(document).mouseup(function (e) {
