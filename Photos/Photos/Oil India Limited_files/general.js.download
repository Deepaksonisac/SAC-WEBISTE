            // Make focusable
            $quickLinks.attr("tabindex", "0");

            // Toggle dropdown on mouse click
            $quickLinks.on("click", function () {
                $("body").toggleClass("custom-dropdown-open");
            });

            // Toggle dropdown on keyboard Enter or Space
            $quickLinks.on("keydown", function (e) {
