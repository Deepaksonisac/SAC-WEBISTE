        // Annual financial results page visitor counter.
        function FinancialPageCounter(element) {
            this.$element = $(element);
            this.$internal = this.$element.find(".financial-counter-internal .count");
            this.$external = this.$element.find(".financial-counter-external .count");
            this.$total = this.$element.find(".financial-counter-total .count");
            this.$infoButton = this.$element.find(".financial-counter-info");
            this.$details = this.$element.find(".financial-counter-details");
            this.basePath = this.getBasePath();
        }

        FinancialPageCounter.prototype.getBasePath = function () {
            var base = $("#base_url").length ? $("#base_url").val() : "/";
            return base + (hindiLang.indexOf("/hi") !== -1 ? "hi/" : "");
        };

        FinancialPageCounter.prototype.init = function () {
            this.bindInfoButton();
            this.loadCounts();
        };

        FinancialPageCounter.prototype.bindInfoButton = function () {
            var self = this;
            if (!this.$infoButton.length || !this.$details.length) {
                return;
            }

            this.$infoButton.on("click", function (event) {
                event.preventDefault();
                event.stopPropagation();
                var open = !self.$details.hasClass("is-open");
                self.$details.toggleClass("is-open", open).prop("hidden", !open);
                self.$infoButton.attr("aria-expanded", open ? "true" : "false");
            });

            $(document).on("click", function (event) {
                if (!self.$element.is(event.target) && self.$element.has(event.target).length === 0) {
                    self.$details.removeClass("is-open").prop("hidden", true);
                    self.$infoButton.attr("aria-expanded", "false");
                }
            });
        };

        FinancialPageCounter.prototype.loadCounts = function () {
            var self = this;
            //console.log(self);
            $.ajax({
                url: this.basePath + "financial-results-page-counter",
                //method: "post",
                cache: false,
                success: function (data) {
                    console.log(data);
                    self.render(data);

                },
                error: function () {
                    console.log("Failed financial page counter entry");
                },
            });
        };

        FinancialPageCounter.prototype.render = function (data) {
            if (!data) {
                return;
            }
           // console.log(data);
            this.setValue(this.$internal, data.internal_count);
            this.setValue(this.$external, data.external_count);
            this.setValue(this.$total, data.count);
        };

        FinancialPageCounter.prototype.setValue = function ($node, value) {
            if ($node.length && typeof value !== "undefined") {
                $node.text(String(value).padStart(6, "0"));
            }
        };

        $(".financial-page-counter").each(function () {
            new FinancialPageCounter(this).init();
        });


