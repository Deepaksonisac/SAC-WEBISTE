        // base_url
        if ($("#base_url").length) {
            var base_url = $("#base_url").val();
            if (base_url != "" || base_url != "undefined") {
                var substring = "/hi";
                //console.log(hindiLang);
                if (hindiLang.indexOf(substring) !== -1) {
                    var durl = base_url + "hi/get-visitor-counter-link";
                } else {
                    var durl = base_url + "get-visitor-counter-link";
                }
                //console.log(durl);
                $.ajax({
                    beforeSend: function () {
                        $(".spinner-border").css("visibility", "visible");
                    },
                    url: durl,
                    method: "post",
                    context: document.body,
                    data: {
                        location: window.location.href
                    },
                    cache: false,
                    success: function (data) {
                        //console.log(data);
                        $(".visitCounter").html(data);
                    },
                    complete: function () {
                        $(".spinner-border").css("visibility", "hidden");
                        //$("#litecontainer").removeAttr('style');
                    },
                    error: function (data) {
                        console.log("Failed Path Entry");
                    },
                });
            }
        }

        function updateFinancialCounters($wrap, data) {
            if (!data) {
                return;
            }
            if (typeof data.internal_count !== "undefined") {
                $wrap.find(".visitor-financial-internal-counter .count").text(data.internal_count);
            }
            if (typeof data.external_count !== "undefined") {
                $wrap.find(".visitor-financial-external-counter .count").text(data.external_count);
            }
        }

        function financialCounterUrl(href, countsOnly) {
            var base_url = $("#base_url").length ? $("#base_url").val() : "";
            if (!base_url || !href) {
                return "";
            }
            var filename = href.split("/").pop().split("?")[0];
            var prefix = hindiLang.indexOf("/hi") !== -1 ? "hi/" : "";
            return base_url + prefix + "files/financial-results-documents/" + filename + (countsOnly ? "/counts" : "");
        }

        $(".financialData").each(function () {
            var $link = $(this);
            var $wrap = $link.closest(".file--application-pdf");
            var countsUrl = financialCounterUrl($link.attr("href"), true);
            if (!countsUrl) {
                return;
            }

            $.ajax({
                url: countsUrl,
                method: "get",
                cache: false,
                success: function (data) {
                    updateFinancialCounters($wrap, data);
                },
            });
        });

        // financialData click counter
        $(document).on("click", ".financialData", function (event) {
            var $wrap = $(this).closest(".file--application-pdf");
            var durl = financialCounterUrl($(this).attr("href"), false);
            if (!durl) {
                return;
            }

            $.ajax({
                url: durl,
                method: "get",
                cache: false,
                success: function (data) {
                    updateFinancialCounters($wrap, data);
                },
                error: function () {
                    console.log("Failed to log financial data click");
                },
            });
        });

